{
  "name": "YouDO",
  "short_name": "YouDO",
  "description": "Execution & Goal Tracker",
  "theme_color": "#000000",
  "background_color": "#000000",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "start_url": "/",
  "scope": "/",
  "id": "youdo-app",
  "icons": [
    {
      "src": "/app-icons/signature/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/signature/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icons/signature/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
