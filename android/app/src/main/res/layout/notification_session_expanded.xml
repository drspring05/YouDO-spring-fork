<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded focus-session card, like a now-playing card: status, task,
     a large live timer and a large play/pause button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/notif_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/notif_brand_gold"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="4dp"
            android:textColor="@color/notif_title_color"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/notif_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:paddingTop="4dp"
            android:textColor="@color/notif_title_color"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/notif_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:textColor="@color/notif_muted_color"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notif_action"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/notif_action_bg"
        android:contentDescription="@string/app_name"
        android:padding="19dp"
        android:src="@drawable/ic_notify_pause" />
</LinearLayout>
